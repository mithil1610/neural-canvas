rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Authentication: Deny all reads/writes if not logged in
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // User-data isolation: Users can only read/write their own documents
    match /users/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow creation/updates but lock down the `tier` field
      allow write: if request.auth != null && request.auth.uid == userId
                   && (!request.resource.data.keys().hasAll(['tier']) 
                       || request.resource.data.tier == resource.data.tier);
    }
  }
}
