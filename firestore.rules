rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Users can only read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // On create, user cannot set server-protected fields:
      // accountTier, tier, aiUsageCount, dailyUploadCount, lastUploadDate
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny([
                      'accountTier', 'tier', 'aiUsageCount', 'dailyUploadCount', 'lastUploadDate'
                    ]);

      // On update, client cannot alter or introduce server-protected fields
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                      'accountTier', 'tier', 'aiUsageCount', 'dailyUploadCount', 'lastUploadDate'
                    ]);

      // Client deletion of user document
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcollections strictly: must have at least one subcollection segment
      // so it does not match /users/{userId} itself
      match /{collectionId}/{docId=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
