platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
  
  # Properly nested share extension block to cleanly inherit the main engine environments natively
  target 'ShareExtension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Step 1: Relax permissions for third-party plugin targets
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # Permits application extensions to compile shared background delegate hooks safely
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
    end
  end

  # Step 2: AUTOMATED DRAG-AND-DROP FIX
  # Programmatically open the main project file and force-inject Flutter search paths into ShareExtension
  begin
    main_project_path = 'Runner.xcodeproj'
    if File.exist?(main_project_path)
      require 'xcodeproj'
      project = Xcodeproj::Project.open(main_project_path)
      
      project.targets.each do |target|
        if target.name == 'ShareExtension'
          target.build_configurations.each do |config|
            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
            
            # Inject explicit framework tracking arrays without erasing existing configurations
            f_paths = config.build_settings['FRAMEWORK_SEARCH_PATHS']
            if f_paths.is_a?(String)
              config.build_settings['FRAMEWORK_SEARCH_PATHS'] = [f_paths, '"$(PROJECT_DIR)/Flutter"']
            elsif f_paths.is_a?(Array)
              config.build_settings['FRAMEWORK_SEARCH_PATHS'] << '"$(PROJECT_DIR)/Flutter"'
            else
              config.build_settings['FRAMEWORK_SEARCH_PATHS'] = ['$(inherited)', '"$(PROJECT_DIR)/Flutter"']
            end

            # Inject explicit header paths for Clang module scanning verification
            h_paths = config.build_settings['HEADER_SEARCH_PATHS']
            if h_paths.is_a?(String)
              config.build_settings['HEADER_SEARCH_PATHS'] = [h_paths, '"$(PROJECT_DIR)/Flutter"']
            elsif h_paths.is_a?(Array)
              config.build_settings['HEADER_SEARCH_PATHS'] << '"$(PROJECT_DIR)/Flutter"'
            else
              config.build_settings['HEADER_SEARCH_PATHS'] = ['$(inherited)', '"$(PROJECT_DIR)/Flutter"']
            end
          end
        end
      end
      project.save
      puts "SUCCESS: Injected native Flutter framework pathways directly into ShareExtension target blueprints!"
    end
  rescue => e
    puts "Warning: Main project target injection routine bypassed: #{e.message}"
  end
end