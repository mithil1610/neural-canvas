platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
  
  target 'ShareExtension' do
    inherit! :search_paths
  end
end

post_install do |installer|
  # Compute the absolute paths directly from the stable cloud Flutter SDK installation
  sdk_root = flutter_root
  engine_framework_dir = File.join(sdk_root, 'bin', 'cache', 'artifacts', 'engine', 'ios', 'Flutter.xcframework', 'ios-arm64')
  engine_headers_dir = File.join(engine_framework_dir, 'Flutter.framework', 'Headers')

  # 1. Inject absolute pathways into all third-party Pod targets
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['APPLICATION_EXTENSION_API_ONLY'] = 'NO'
      
      # Hard-inject absolute SDK paths so Clang module scanning finds them unconditionally
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
      if config.build_settings['FRAMEWORK_SEARCH_PATHS'].is_a?(String)
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] += " \"#{engine_framework_dir}\""
      else
        config.build_settings['FRAMEWORK_SEARCH_PATHS'] << engine_framework_dir
      end

      config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
      if config.build_settings['HEADER_SEARCH_PATHS'].is_a?(String)
        config.build_settings['HEADER_SEARCH_PATHS'] += " \"#{engine_headers_dir}\""
      else
        config.build_settings['HEADER_SEARCH_PATHS'] << engine_headers_dir
      end
    end
  end

  # 2. Inject absolute pathways directly into the main project target blueprints
  begin
    main_project_path = 'Runner.xcodeproj'
    if File.exist?(main_project_path)
      require 'xcodeproj'
      project = Xcodeproj::Project.open(main_project_path)
      project.targets.each do |target|
        if target.name == 'ShareExtension' || target.name == 'Runner'
          target.build_configurations.each do |config|
            config.build_settings['FRAMEWORK_SEARCH_PATHS'] ||= ['$(inherited)']
            if config.build_settings['FRAMEWORK_SEARCH_PATHS'].is_a?(String)
              config.build_settings['FRAMEWORK_SEARCH_PATHS'] += " \"#{engine_framework_dir}\""
            else
              config.build_settings['FRAMEWORK_SEARCH_PATHS'] << engine_framework_dir
            end

            config.build_settings['HEADER_SEARCH_PATHS'] ||= ['$(inherited)']
            if config.build_settings['HEADER_SEARCH_PATHS'].is_a?(String)
              config.build_settings['HEADER_SEARCH_PATHS'] += " \"#{engine_headers_dir}\""
            else
              config.build_settings['HEADER_SEARCH_PATHS'] << engine_headers_dir
            end
            
            if target.name == 'Runner'
              config.build_settings['CODE_SIGN_ENTITLEMENTS'] = 'Runner/Runner.entitlements'
            elsif target.name == 'ShareExtension'
              config.build_settings['CODE_SIGN_ENTITLEMENTS'] = 'ShareExtension/ShareExtension.entitlements'
            end
          end
        end
      end
      project.save
      puts "Successfully synchronized absolute SDK paths to target blueprints."
    end
  rescue => e
    puts "Project file sync bypassed: #{e.message}"
  end
end